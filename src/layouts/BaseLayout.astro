---
import '../styles/global.css'
import { t, tAll, loc } from '../i18n/utils'
import Tr from '../components/ui/Tr.astro'
import education from '../data/education.json'
import Nav from '../components/Nav.astro'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
const pageTitle = title ?? t('en', 'meta.title')
const pageDesc = description ?? t('en', 'meta.description')

const siteUrl = 'https://cibran.es'
const canonicalUrl = siteUrl
const ogImage = `${siteUrl}/og-image.jpg`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Cibrán Docampo Piñeiro',
  jobTitle: 'Senior Software Developer',
  worksFor: { '@type': 'Organization', name: 'Plexus Tech' },
  url: siteUrl,
  image: `${siteUrl}/og-image.jpg`,
  email: 'hola@cibran.es',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cangas',
    addressRegion: 'Galicia',
    addressCountry: 'ES',
  },
  sameAs: [
    'https://www.linkedin.com/in/cidocampo/',
    'https://github.com/cibrandocampo',
    'https://hub.docker.com/u/cibrandocampo',
  ],
  knowsAbout: [
    'Python', 'FastAPI', 'Django', 'Flask', 'C++',
    'PostgreSQL', 'ClickHouse', 'Kafka', 'DynamoDB',
    'AWS', 'Serverless', 'Docker', 'Kubernetes',
    'Backend Development', 'Big Data', 'Data Engineering',
    'Event-driven Architecture', 'System Integration', 'Cloud Architecture',
    'Observability', 'LLM Integration', 'AI-assisted Software Engineering',
    'FFmpeg', 'IPTV', 'HLS', 'DASH',
  ],
  knowsLanguage: [
    { '@type': 'Language', name: 'Galician' },
    { '@type': 'Language', name: 'Spanish' },
    { '@type': 'Language', name: 'English' },
    { '@type': 'Language', name: 'Portuguese' },
  ],
  // Generated from src/data/education.json so structured data never drifts from the page
  alumniOf: education.formal.map(d => ({
    '@type': 'EducationalOrganization',
    name: d.institution,
    description: `${loc(d.degree).en} (${d.period.replace(' – ', '–')})`,
  })),
  hasCredential: education.certifications.map(c => ({
    '@type': 'EducationalOccupationalCredential',
    name: loc(c.name).en,
    credentialCategory: c.issuer === 'AESA' ? 'license' : 'certificate',
    recognizedBy: { '@type': 'Organization', name: c.issuer },
    ...(c.year ? { dateCreated: String(c.year) } : {}),
  })),
}

const jsonLdWebsite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  url: siteUrl,
  name: 'Cibrán Docampo',
  author: {
    '@type': 'Person',
    name: 'Cibrán Docampo Piñeiro',
  },
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="author" content="Cibrán Docampo Piñeiro" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <title>{pageTitle}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Cibrán Docampo" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="profile:first_name" content="Cibrán" />
    <meta property="profile:last_name" content="Docampo Piñeiro" />
    <meta property="profile:username" content="cibrandocampo" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD — Person -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- JSON-LD — WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />

    <!-- Fonts (non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap"
      />
    </noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-zinc-900 text-zinc-100 font-sans antialiased pt-16">
    <!-- Language detection: reads stored preference or detects from browser, applies lang-XX class before first paint -->
    <script is:inline>
      ;(function () {
        var stored = null
        try { stored = localStorage.getItem('lang') } catch (e) {}
        var lang = stored
        if (!lang) {
          var langs = (navigator.languages && navigator.languages.length
            ? Array.from(navigator.languages)
            : [navigator.language]
          ).map(function (l) { return (l || '').toLowerCase() })
          lang = 'en'
          for (var i = 0; i < langs.length; i++) {
            if (langs[i].startsWith('gl')) { lang = 'gl'; break }
            if (langs[i].startsWith('es') || langs[i].startsWith('ca') || langs[i].startsWith('eu')) {
              lang = 'es'; break
            }
          }
          try { localStorage.setItem('lang', lang) } catch (e) {}
        }
        document.documentElement.classList.add('lang-' + lang)
        document.documentElement.lang = lang
      })()
    </script>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded focus:bg-zinc-800 focus:text-white focus:border focus:border-accent"
    >
      <Tr {...tAll('a11y.skip')} />
    </a>
    <Nav />
    <slot />
  </body>
</html>
