---
import { tAll, loc } from '../../i18n/utils'
import Tr from '../ui/Tr.astro'
import SectionTitle from '../ui/SectionTitle.astro'
import SkillHighlight from '../ui/SkillHighlight.astro'
import AccordionEntry from '../ui/AccordionEntry.astro'
import profile from '../../data/profile.json'
import skills from '../../data/skills.json'
import timeline from '../../data/timeline.json'
import education from '../../data/education.json'
import { GraduationCap, BadgeCheck } from '@lucide/astro'
---

<section id="professional" class="py-24 bg-zinc-900">
  <div class="max-w-6xl mx-auto px-4 space-y-16">

    <SectionTitle><Tr {...tAll('section.resume')} /></SectionTitle>

    <!-- Intro -->
    <div class="max-w-3xl -mt-8 flex flex-col gap-3">
      {(['en', 'es', 'gl'] as const).map(lang =>
        profile.resumeBio[lang].map((p: string, i: number, arr: string[]) => (
          <p lang={lang} class={`i18n-${lang} leading-relaxed ${i === arr.length - 1 ? 'font-semibold text-white' : 'text-zinc-300'}`}>
            {p}
          </p>
        ))
      )}
    </div>

    <!-- Block 1: Skill highlights -->
    <div>
      <h3 class="text-xs font-medium uppercase tracking-widest text-zinc-300 mb-6">
        <Tr {...tAll('professional.highlights_title')} />
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {skills.highlights[0] && (
          <div class="md:row-span-2 h-full">
            <SkillHighlight
              icon={skills.highlights[0].icon}
              tag={skills.highlights[0].tag}
              name={skills.highlights[0].name}
              description={skills.highlights[0].description}
            />
          </div>
        )}
        {skills.highlights.slice(1).map(h => (
          <SkillHighlight
            icon={h.icon}
            tag={h.tag}
            name={h.name}
            description={h.description}
          />
        ))}
      </div>
    </div>

    <!-- Block 2: Experience accordion -->
    <div>
      <h3 class="text-xs font-medium uppercase tracking-widest text-zinc-300 mb-6">
        <Tr {...tAll('professional.experience_title')} />
      </h3>
      <div id="accordion" class="border-t border-zinc-700/50">
        {timeline.map((entry, idx) => (
          <AccordionEntry
            period={entry.period}
            company={entry.company}
            role={entry.role}
            projects={entry.projects}
            open={idx === 0}
          />
        ))}
      </div>
    </div>

    <!-- Block 3: Education — degrees + courses & certifications -->
    <div>
      <h3 class="text-xs font-medium uppercase tracking-widest text-zinc-300 mb-6">
        <Tr {...tAll('professional.education_title')} />
      </h3>

      <p class="text-xs uppercase tracking-widest text-zinc-400 mb-3">
        <Tr {...tAll('professional.degrees_title')} />
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        {education.formal.map(d => (
          <div class="flex gap-4 p-5 bg-zinc-800 border border-zinc-700 rounded-lg">
            <GraduationCap size={22} class="text-accent flex-shrink-0 mt-0.5" />
            <div class="flex flex-col gap-1">
              <span class="text-xs text-accent uppercase tracking-widest">{d.period}</span>
              <h4 class="text-sm font-semibold text-white leading-snug"><Tr {...loc(d.degree)} /></h4>
              <span class="text-sm text-zinc-400">{d.institution}</span>
              {d.description && (
                <p class="text-xs text-zinc-400 leading-relaxed mt-1"><Tr {...loc(d.description)} /></p>
              )}
            </div>
          </div>
        ))}
      </div>

      <p class="text-xs uppercase tracking-widest text-zinc-400 mb-3">
        <Tr {...tAll('professional.courses_title')} />
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        {education.certifications.map(c => (
          <li class="flex items-start gap-2 p-3 bg-zinc-800/50 border border-zinc-700/30 rounded-lg">
            <BadgeCheck size={15} class="text-brand flex-shrink-0 mt-0.5" />
            <div class="flex flex-col">
              <span class="text-xs text-zinc-200 leading-snug"><Tr {...loc(c.name)} /></span>
              <span class="text-xs text-zinc-400">{c.issuer}{'year' in c && c.year ? ` · ${c.year}` : ''}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<script is:inline>
  ;(function () {
    var accordion = document.getElementById('accordion')
    if (!accordion) return

    function setOpen(entry, open) {
      var body = entry.querySelector('.accordion-body')
      var chevron = entry.querySelector('.chevron')
      if (open) {
        body.style.gridTemplateRows = '1fr'
        chevron.style.transform = 'rotate(180deg)'
        entry.dataset.open = 'true'
        entry.querySelector('.accordion-trigger').setAttribute('aria-expanded', 'true')
      } else {
        // Collapse "Read more" details when the company block closes
        entry.querySelectorAll('.project-details').forEach(function (d) {
          d.open = false
        })
        body.style.gridTemplateRows = '0fr'
        chevron.style.transform = 'rotate(0deg)'
        entry.dataset.open = 'false'
        entry.querySelector('.accordion-trigger').setAttribute('aria-expanded', 'false')
      }
    }

    accordion.querySelectorAll('.accordion-trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var entry = trigger.closest('.accordion-entry')
        var isOpen = entry.dataset.open === 'true'
        // Close all
        accordion.querySelectorAll('.accordion-entry').forEach(function (e) {
          setOpen(e, false)
        })
        // Open the clicked one if it was closed
        if (!isOpen) setOpen(entry, true)
      })
    })

    // "Read more" on any card expands every card of the same company block
    accordion.querySelectorAll('.project-details > summary').forEach(function (summary) {
      summary.addEventListener('click', function (e) {
        e.preventDefault()
        var entry = summary.closest('.accordion-entry')
        entry.querySelectorAll('.project-details').forEach(function (d) {
          d.open = true
        })
      })
    })

    // Set initial open state for the first entry
    var first = accordion.querySelector('.accordion-entry[data-open="true"]')
    if (first) setOpen(first, true)
  })()
</script>
